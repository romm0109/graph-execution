---
// The run as one picture: spec → tasks → parallel agents → gate → review + live test → fix → PR.
const box = { w: 104, h: 40 };
const nodes = [
  { id: "spec", x: 16, y: 80, label: "Spec" },
  { id: "tasks", x: 152, y: 80, label: "Tasks" },
  { id: "a1", x: 288, y: 20, label: "Agent" },
  { id: "a2", x: 288, y: 80, label: "Agent" },
  { id: "a3", x: 288, y: 140, label: "Agent" },
  { id: "gate", x: 424, y: 80, label: "Gate" },
  { id: "review", x: 560, y: 50, label: "Code review" },
  { id: "live", x: 560, y: 110, label: "Live test" },
  { id: "fix", x: 696, y: 80, label: "Fix" },
  { id: "pr", x: 832, y: 80, label: "Pull request", accent: true },
];
const byId = Object.fromEntries(nodes.map((n) => [n.id, n]));
const edges = [
  ["spec", "tasks"],
  ["tasks", "a1"],
  ["tasks", "a2"],
  ["tasks", "a3"],
  ["a1", "gate"],
  ["a2", "gate"],
  ["a3", "gate"],
  ["gate", "review"],
  ["gate", "live"],
  ["review", "fix"],
  ["live", "fix"],
  ["fix", "pr"],
];
const path = (from: string, to: string) => {
  const a = byId[from];
  const b = byId[to];
  const x1 = a.x + box.w;
  const y1 = a.y + box.h / 2;
  const x2 = b.x;
  const y2 = b.y + box.h / 2;
  const mx = (x1 + x2) / 2;
  return `M${x1} ${y1} C${mx} ${y1} ${mx} ${y2} ${x2 - 6} ${y2}`;
};
---

<div class="flow">
  <svg
    viewBox="0 0 952 200"
    role="img"
    aria-labelledby="flow-title"
    xmlns="http://www.w3.org/2000/svg"
  >
    <title id="flow-title">
      A spec becomes tasks, three agents run them in parallel, a gate checks each task, a code
      review and a live test check the merged result, a fixer handles what they find, and a pull
      request opens.
    </title>
    <defs>
      <marker id="arrow" viewBox="0 0 10 10" refX="4" refY="5" markerWidth="7" markerHeight="7" orient="auto">
        <path d="M0 0 L10 5 L0 10 z" fill="#9aa3c0"></path>
      </marker>
    </defs>
    {
      edges.map(([from, to]) => (
        <path d={path(from, to)} fill="none" stroke="#3a4670" stroke-width="1.5" marker-end="url(#arrow)" />
      ))
    }
    {
      nodes.map((n) => (
        <g>
          <rect
            x={n.x}
            y={n.y}
            width={box.w}
            height={box.h}
            rx="8"
            fill={n.accent ? "#4fd1ff" : "#161c34"}
            stroke={n.accent ? "#4fd1ff" : "#2c3760"}
          />
          <text
            x={n.x + box.w / 2}
            y={n.y + box.h / 2 + 5}
            text-anchor="middle"
            font-size="14"
            font-family="system-ui, sans-serif"
            font-weight="600"
            fill={n.accent ? "#04121a" : "#e6e9f5"}
          >
            {n.label}
          </text>
        </g>
      ))
    }
  </svg>
</div>
