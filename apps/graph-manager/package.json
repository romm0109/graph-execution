{
  "name": "graph-manager",
  "version": "0.1.0",
  "private": true,
  "description": "Web service around graph-execution: workspaces, terminals, runs and pull requests",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "start": "node dist/server/main.js",
    "postinstall": "node -e \"if(process.platform!=='darwin')process.exit(0);const fs=require('node:fs'),p=require('node:path');let d;try{d=p.dirname(require.resolve('node-pty/package.json'))}catch{process.exit(0)}for(const a of ['darwin-arm64','darwin-x64']){const f=p.join(d,'prebuilds',a,'spawn-helper');if(fs.existsSync(f))fs.chmodSync(f,0o755)}\""
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^31.0.0",
    "vite": "^8.3.6",
    "ws": "^8.22.1"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^10.1.10",
    "@fastify/websocket": "^11.3.7",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "execa": "^9.6.1",
    "fastify": "^5.12.8",
    "graph-execution": "*",
    "node-pty": "^1.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7"
  }
}
