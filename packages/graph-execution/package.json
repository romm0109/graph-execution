{
  "name": "graph-execution",
  "version": "2.0.0",
  "description": "Dependency-graph task executor for AI coding agents",
  "keywords": [
    "ai",
    "agents",
    "claude-code",
    "codex",
    "opencode",
    "qwen-code",
    "dag",
    "git-worktree",
    "cli"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/romm0109/graph-execution.git",
    "directory": "packages/graph-execution"
  },
  "homepage": "https://github.com/romm0109/graph-execution#readme",
  "bugs": {
    "url": "https://github.com/romm0109/graph-execution/issues"
  },
  "type": "module",
  "bin": {
    "graph-execution": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/cli.js",
    "./api": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "skills",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.build.json",
    "postbuild": "node -e \"require('node:fs').chmodSync('dist/cli.js', 0o755)\" && node -e \"const fs=require('node:fs');fs.mkdirSync('dist/web',{recursive:true});fs.copyFileSync('src/web/page.html','dist/web/page.html');fs.mkdirSync('dist/suite',{recursive:true});fs.copyFileSync('src/suite/page.html','dist/suite/page.html');fs.cpSync('src/web/assets','dist/web/assets',{recursive:true,filter:(f)=>!f.endsWith('.test.ts')})\" && node scripts/render-readme.mjs README.md dist/README.html",
    "bundle:manager": "node scripts/bundle-manager.mjs",
    "prepublishOnly": "npm run typecheck && npx eslint . && npm test && npm --prefix ../.. run build"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^10.1.10",
    "@fastify/websocket": "^11.3.7",
    "commander": "^14.0.3",
    "execa": "^9.6.1",
    "fastify": "^5.12.8",
    "ink": "^6.8.0",
    "ink-spinner": "^5.0.0",
    "node-pty": "^1.1.0",
    "react": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "ink-testing-library": "^4.0.0",
    "marked": "^18.1.1"
  }
}
